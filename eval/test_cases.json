      "must_not_recommend": ["rainbow_six_siege"],
      "max_price_for_buy": 15.0
    }
  },
  {
    "id": "tc05_multiplayer_required",
    "message": "I want a multiplayer-required game under $10 to play with 4 friends.",
    "expect": {
      "must_recommend_any_of": ["left_4_dead_2", "borderlands_2", "rainbow_six_siege", "deep_rock_galactic", "terraria"],
      "max_price_for_buy": 10.0
    }
  },
  {
    "id": "tc06_followup_replay_value",
    "history": [
      {"role": "user", "content": "Budget $30. I like co-op survival games."},
      {"role": "assistant", "content": "Looked at Valheim ($13.99) and Deep Rock Galactic ($9.89)."}
    ],
    "message": "Which of those has more replay value?",
    "expect": {
      "must_recommend_any_of": ["valheim", "deep_rock_galactic"]
    }
  },
  {
    "id": "tc07_factorio_full_price_skip_or_wait",
    "message": "Should I buy Factorio right now? Budget $40, target $20.",
    "expect": {
      "must_recommend_any_of": ["factorio"],
      "expected_verdict_for": {"factorio": "Wait"}
    }
  },
  {
    "id": "tc08_at_historical_low",
    "message": "Stardew Valley is $7.49 right now. Budget $20, I like farming and indie. Worth it?",
    "expect": {
      "must_recommend_any_of": ["stardew_valley"],
      "expected_verdict_for": {"stardew_valley": "Buy"}
    }
  },
  {
    "id": "tc09_overbudget_should_not_buy",
