[
  {
    "id": "tc01_coop_fps_under_20",
    "message": "I have $20 to spend. I love co-op FPS games and I already play Apex Legends and Left 4 Dead.",
    "expect": {
      "must_recommend_any_of": ["deep_rock_galactic", "borderlands_2", "left_4_dead_2"],
      "must_not_recommend": ["cyberpunk_2077", "baldurs_gate_3", "elden_ring", "factorio"],
      "max_price_for_buy": 20.0,
      "expected_verdict_for": {"deep_rock_galactic": "Buy", "borderlands_2": "Buy"}
    }
  },
  {
    "id": "tc02_hades_target_price_wait",
    "message": "I'm tracking Hades. My budget is $25 but my target price is $15. I love single-player roguelikes.",
    "expect": {
      "must_recommend_any_of": ["hades"],
      "expected_verdict_for": {"hades": "Wait"},
      "must_mention_keywords": ["target", "12.49"]
    }
  },
  {
    "id": "tc03_no_results_above_budget",
    "message": "I have $5 and I want a brand new AAA open world RPG.",
    "expect": {
      "must_not_recommend_buy_above": 5.0
    }
  },
  {
    "id": "tc04_singleplayer_only",
